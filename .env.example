# Copy to .env.local and fill in. See docs/google-setup.md for where each value comes from.

# --- Database (SQLite file, created by `npm run db:push`) ---
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Demo mode ---
# "true" adds a "Continue as demo user" sign-in and uses a simulated calendar,
# so the whole app works before any Google setup is done.
DEMO_MODE="true"

# --- Google OAuth (per-user Calendar access) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only allow accounts from your Workspace domain (e.g. "example.com"). Leave empty to skip the check.
GOOGLE_WORKSPACE_DOMAIN=""

# --- Admin SDK Directory sync (optional, needs a Workspace admin) ---
# Path to the service account JSON key with domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./secrets/roomzoom.service-account.json"
# An admin user the service account impersonates when reading room resources.
GOOGLE_ADMIN_IMPERSONATE_EMAIL=""

# --- Cloud Vision OCR for floor plan labels (optional) ---
GOOGLE_VISION_API_KEY=""

# --- Access to /admin in production builds (comma-separated). Always open in `npm run dev`. ---
ADMIN_EMAILS=""

# --- Walking distance tuning ---
# Extra feet added per floor change when a route needs stairs/elevator.
FLOOR_CHANGE_PENALTY_FT="60"
